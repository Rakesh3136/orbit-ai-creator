# Local development only; use a secret manager in deployed environments.
DATABASE_URL=postgresql+psycopg://aimn:change-me@localhost:5432/aimn
AIMN_ADMIN_API_KEY=replace-with-a-long-random-value

# Owner sign-in. Generate the password hash using the README instructions.
AIMN_OWNER_EMAIL=owner@example.com
AIMN_OWNER_PASSWORD_HASH=
# Use a random value of at least 32 characters; never commit a real value.
AIMN_SESSION_SECRET=replace-with-a-random-32-plus-character-value
AIMN_SESSION_TTL_SECONDS=43200
AIMN_SESSION_COOKIE_SECURE=false
AIMN_WEB_ORIGIN=http://localhost:3000

# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key in the deployment secret store, separate from the database.
AIMN_CREDENTIAL_ENCRYPTION_KEY=
