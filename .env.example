# ORBIT configuration
ORBIT_MODE=development
ORBIT_DB_PATH=data/orbit.sqlite3
ORBIT_MIN_IDEA_SCORE=70
ORBIT_REQUIRE_HUMAN_APPROVAL=true

# Optional local model provider. No paid API is required.
# ORBIT_LLM_PROVIDER=ollama
# ORBIT_OLLAMA_MODEL=<your-local-model-name>

# Optional YouTube credentials. Never commit real values.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=
