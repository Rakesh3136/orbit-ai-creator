POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AIMN_OWNER_EMAIL=owner@example.com
AIMN_OWNER_PASSWORD_HASH=
AIMN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AIMN_SESSION_TTL_SECONDS=43200
# false is required for local http://localhost development; set true behind HTTPS.
AIMN_SESSION_COOKIE_SECURE=false
AIMN_WEB_ORIGIN=http://localhost:3000
# 0.0.0.0 allows other devices on your trusted LAN to open AIMN.
AIMN_BIND_HOST=0.0.0.0

# Optional local inference. Default is deterministic templates and no model.
AIMN_LLM_PROVIDER=none
AIMN_OLLAMA_URL=http://ollama:11434
AIMN_OLLAMA_MODEL=qwen2.5:3b

# Generate a complete private .env with: python scripts/aimn_setup.py
# Never commit .env, OAuth client JSON, access tokens or refresh tokens.
