POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AIMN_OWNER_EMAIL=owner@example.com
AIMN_OWNER_PASSWORD_HASH=
AIMN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AIMN_SESSION_TTL_SECONDS=43200
AIMN_SESSION_COOKIE_SECURE=true
AIMN_WEB_ORIGIN=http://localhost:3000

# Generate a complete private .env with: python scripts/aimn_setup.py
# Never commit .env, OAuth client JSON, access tokens or refresh tokens.
